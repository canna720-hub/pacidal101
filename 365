  // ===== 渲染 =====
  function el(tag, cls, text) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  const GATE_NAMES = { "1": "自我表達", "2": "自我方向", "3": "秩序", "4": "公式化", "5": "固定模式", "6": "摩擦", "7": "自我角色", "8": "貢獻", "9": "專注", "10": "自我行為", "11": "想法", "12": "謹慎", "13": "聆聽者", "14": "強大技能", "15": "極端", "16": "技能", "17": "意見", "18": "修正", "19": "渴望", "20": "當下", "21": "獵人", "22": "開放", "23": "同化", "24": "合理化", "25": "自我精神", "26": "利己主義者", "27": "照顧", "28": "玩家", "29": "毅力", "30": "感覺的認知", "31": "影響力", "32": "持續", "33": "隱私", "34": "力量", "35": "改變", "36": "危機", "37": "友誼", "38": "對立", "39": "挑釁", "40": "獨處", "41": "收縮", "42": "成長", "43": "洞見", "44": "警覺", "45": "聚集者", "46": "自我決心", "47": "了悟", "48": "深度", "49": "原則", "50": "價值觀", "51": "衝擊", "52": "靜止", "53": "開始", "54": "野心", "55": "精神", "56": "刺激", "57": "直覺清明", "58": "活力", "59": "打破隔閡", "60": "接受限制", "61": "神秘", "62": "細節", "63": "懷疑", "64": "困惑" };

  function nameGates(s) {
    return s
      .replace(/(\d{1,2}) 號(「[^」]*」)?/g, "$1")
      .replace(/(?<![\d:：.])(?<!第\s?)(\d{1,2})(?![\d:]|（|\s?爻|、\d+\s?爻)/g, (m, n) => (GATE_NAMES[n] ? n + "（" + GATE_NAMES[n] + "）" : m));
  }

  const TYPE_COLORS = { "生產者": "#c0662e", "顯示生產者": "#b5892a", "顯示者": "#3d7fb0", "投射者": "#7a5aa6", "反映者": "#3f8f5c" };

  function fillWithChannels(p, t) {
    const re = /\d{1,2}-\d{1,2} ?[^\s（、，。：；]{1,6}通道/g;
    let last = 0, m;
    while ((m = re.exec(t)) !== null) {
      p.appendChild(document.createTextNode(nameGates(t.slice(last, m.index))));
      p.appendChild(el("mark", "channel", nameGates(m[0])));
      last = m.index + m[0].length;
    }
    p.appendChild(document.createTextNode(nameGates(t.slice(last))));
  }

  function renderBody(text) {
    const frag = document.createDocumentFragment();
    text.split(/\n\s*\n/).forEach((chunk) => {
      const t = chunk.trim();
      if (!t) return;
      if (t.startsWith("#### ")) frag.appendChild(el("h4", "", nameGates(t.slice(5))));
      else if (t.startsWith("### ")) frag.appendChild(el("h3", "", nameGates(t.slice(4))));
      else if (t.startsWith("## ")) frag.appendChild(el("h2", "", nameGates(t.slice(3))));
      else {
        const p = el("p", "");
        const m = t.match(/^([^：\n]{1,12}|如果你本來就有[^：\n]{1,40})：/);
        if (m) {
          const c = TYPE_COLORS[m[1]];
          const s = el("strong", "lead", nameGates(m[1]) + "：");
          if (c) { s.style.color = c; s.style.background = c + "22"; s.style.padding = "1px 6px"; s.style.borderRadius = "4px"; }
          p.appendChild(s);
          fillWithChannels(p, t.slice(m[0].length));
        } else {
          fillWithChannels(p, t);
        }
        frag.appendChild(p);
      }
    });
    return frag;
  }

  function renderIssue(issue) {
    const frag = document.createDocumentFragment();
    frag.appendChild(el("p", "date", issue.date));
    frag.appendChild(el("div", "theme", issue.theme));
    frag.appendChild(renderBody(issue.body));
    return frag;
  }

  function renderToday() {
    const card = document.getElementById("todayCard");
    card.textContent = "";
    if (ISSUES.length) card.appendChild(renderIssue(ISSUES[0]));
    else card.appendChild(el("p", "", "尚無內容"));
  }

  function renderArchive() {
    const list = document.getElementById("archiveList");
    list.textContent = "";
    ISSUES.forEach((issue) => {
      const btn = el("button", "");
      btn.appendChild(el("div", "", issue.theme));
      btn.appendChild(el("div", "meta", issue.date));
      btn.addEventListener("click", () => {
        const card = document.getElementById("todayCard");
        card.textContent = "";
        card.appendChild(renderIssue(issue));
        document.getElementById("today").scrollIntoView({ behavior: "smooth" });
      });
      list.appendChild(btn);
    });
  }

  // ===== 按鈕 =====
  document.getElementById("orderBtn").href = ORDER_URL;

  renderToday();
  renderArchive();
</script>
